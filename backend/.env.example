# HireLens backend — copy to .env and fill in your own values. Never commit .env.
# Port the server listens on. Render sets PORT automatically — leave the
# default here for local development only.
PORT=5000
# MongoDB Atlas connection string (see README: "MongoDB Atlas setup").
# Create a free cluster, a database user, and allow network access (0.0.0.0/0
# for Render, or Render's outbound IPs). Database name: hirelens.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hirelens?retryWrites=true&w=majority
# Optional: Google Gemini API key for AI matching / code review.
# Without it, HireLens uses its built-in deterministic scorer + heuristic
# reviewer, so the app still works end to end.
GEMINI_API_KEY=
# Used for future auth tokens. Set a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the deployed Vercel frontend, e.g. https://hirelens.vercel.app
# CORS only allows this origin (comma-separated for more than one).
# Leave empty locally to allow all origins during development.
FRONTEND_URL=
