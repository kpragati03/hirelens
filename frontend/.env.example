# HireLens frontend — copy to .env for local dev, or set in Vercel → Settings → Environment Variables.
# URL of the deployed Express backend (Render / Railway), including /api.
# Leave unset for local dev — the Vite proxy forwards /api to http://localhost:5000.
VITE_API_URL=
# Optional: Piston code-execution API base URL. Leave unset to use the in-browser sandboxed runner.
# VITE_PISTON_API_URL=https://emkc.org/api/v2/piston
